# ChatBI 配置样例。复制为 .env 后填入真实值。
# .env 含数据库口令,已在 .gitignore 中,严禁入库。

# ── 数据库(平台业务库,只读账号)────────────────────────────
CHATBI_DB_HOST=127.0.0.1
CHATBI_DB_PORT=33060
CHATBI_DB_USER=chatbi_ro
CHATBI_DB_PASSWORD=在这里填 chatbi_ro 的口令
CHATBI_DB_NAME=ainative_v2

# ── 数据空间隔离 ────────────────────────────────────────────
CHATBI_WORKSPACE_ID=2

# ── LLM 端点(不填则回退到 ANTHROPIC_* 与 runtime.env)───────
# CHATBI_ANTHROPIC_BASE_URL=http://127.0.0.1:15723
# CHATBI_ANTHROPIC_AUTH_TOKEN=sk-...
# CHATBI_ANTHROPIC_MODEL=claude-sonnet-4-5
# 该端点的模型会输出扩展思考,max_tokens 过小会被截断
# CHATBI_ANTHROPIC_MAX_TOKENS=32768

# ── 行为参数 ────────────────────────────────────────────────
# CHATBI_TABLE_MAX_ROWS=20
# CHATBI_MAX_RETRIES=3
# CHATBI_OUTPUT_DIR=deliverables/chatbi
